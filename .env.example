# Clerk (invite-only — keep sign-up mode Invite-only in the Clerk dashboard)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Neon Postgres
DATABASE_URL=

# VeriCase AWS S3 — same bucket/region/keys as VeriCase production
S3_BUCKET=
S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional aliases VeriCase also accepts:
# MINIO_BUCKET=
# AWS_REGION=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# Prefix so Meritus objects sit beside VeriCase objects, not on top of them
S3_KEY_PREFIX=meritus

# AI Gateway — OIDC from `vercel env pull` is enough on Vercel.
# Optional static key for non-Vercel environments:
AI_GATEWAY_API_KEY=

# Optional
COMPANIES_HOUSE_API_KEY=

# Resend — alerts to the directors when an enquiry arrives. Optional: without it alerts are skipped.
RESEND_API_KEY=
ENQUIRY_ALERT_FROM=enquiries@meritusvia.com
