# Clerk (keep sign-up mode Invite-only in the Clerk dashboard)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Neon Postgres
DATABASE_URL=

# Private AWS S3 configuration for the intended environment
S3_BUCKET=
S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional aliases VeriCase also accepts:
# MINIO_BUCKET=
# AWS_REGION=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# Prefix so Meritus objects sit beside VeriCase objects, not on top of them
S3_KEY_PREFIX=meritus

# AI Gateway: OIDC from `vercel env pull` is enough on Vercel.
# Optional static key for non-Vercel environments:
AI_GATEWAY_API_KEY=

# Optional
COMPANIES_HOUSE_API_KEY=

# Resend: alerts to the directors when an enquiry arrives. Optional: without it alerts are skipped.
RESEND_API_KEY=
ENQUIRY_ALERT_FROM=enquiries@meritusvia.com
# Optional: origin used in the emailed client access link (default https://meritusvia.com)
ACCESS_LINK_ORIGIN=

# QCS director research. Keep secrets in the runtime secret manager.
CRON_SECRET=
RESEARCH_COMPANIES_HOUSE_API_KEY=
# Identifiable crawler contact, an HTTPS or mailto URL.
RESEARCH_CONTACT_URL=
RESEARCH_SNAPSHOT_MAX_BYTES=1073741824
RESEARCH_WORKER_BUDGET_MS=900000

# Intelligence analyst service, server-only. The service runs separately from Next.js.
# HTTPS origin only, with no path, username, password, query or fragment.
INTELLIGENCE_SERVICE_URL=
# At least 32 characters. Match MERITUS_PORTAL_BRIDGE_SECRET on the analyst service.
# Keep the shared secret in each deployment's runtime secret manager.
INTELLIGENCE_BRIDGE_SECRET=
