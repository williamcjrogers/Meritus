# Clerk (invite-only — keep sign-up mode Invite-only in the Clerk dashboard)
# Partner: /sign-in → /portal. Client: /client/sign-in → /client.
# Client invitation redirectUrl: https://www.meritusvia.com/client/sign-up
# Director invitation redirectUrl: https://www.meritusvia.com/sign-up
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Neon Postgres
DATABASE_URL=

# Vercel Blob
BLOB_READ_WRITE_TOKEN=

# AI Gateway — OIDC from `vercel env pull` is enough on Vercel.
# Optional static key for non-Vercel environments:
AI_GATEWAY_API_KEY=

# Optional
COMPANIES_HOUSE_API_KEY=

# Resend — alerts to the directors when an enquiry arrives. Optional: without it alerts are skipped.
RESEND_API_KEY=
ENQUIRY_ALERT_FROM=enquiries@meritusvia.com

# VeriCase WR2.0 archive — same AWS settings as that tenant. Optional: without these the client desk still loads.
VERICASE_AWS_ACCESS_KEY_ID=
VERICASE_AWS_SECRET_ACCESS_KEY=
VERICASE_AWS_REGION=
VERICASE_S3_BUCKET=
VERICASE_S3_PREFIX=
