# Clerk (invite-only — keep sign-up mode Invite-only in the Clerk dashboard)
# Partner: /sign-in → /portal. Client login is invite-only with publicMetadata.role=client.
# Client: /client/sign-in → /client. Invitation redirectUrl: https://meritusvia.com/client/sign-up
# Matter files stay in VeriCase WR2.0 S3 — this app does not stream or re-host them.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Neon Postgres
DATABASE_URL=

# Vercel Blob
BLOB_READ_WRITE_TOKEN=

# AI Gateway — OIDC from `vercel env pull` is enough on Vercel.
# Optional static key for non-Vercel environments:
AI_GATEWAY_API_KEY=

# Optional
COMPANIES_HOUSE_API_KEY=

# Resend — alerts to the directors when an enquiry arrives. Optional: without it alerts are skipped.
RESEND_API_KEY=
ENQUIRY_ALERT_FROM=enquiries@meritusvia.com

# Optional later — do not call a guessed VeriCase REST API from this app yet.
# VERICASE_API_BASE_URL=
# VERICASE_API_TOKEN=
