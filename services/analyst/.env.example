# Run make configure to create a random private PostgreSQL password.
POSTGRES_PASSWORD=replace-with-a-random-local-value
# Credentials are process-only. Recording source permission is a separate action in the app.
MERITUS_COMPANIES_HOUSE_API_KEY=
MERITUS_COMPANIES_HOUSE_STREAM_KEY=
MERITUS_ORGANISATIONAL_CONTACT=
MERITUS_ADZUNA_APP_ID=
MERITUS_ADZUNA_APP_KEY=
MERITUS_RNS_USER=
MERITUS_RNS_ACCESS_KEY=
MERITUS_RNS_BASE_URL=
MERITUS_HMCTS_RECEIVER_TOKEN=

# Hosted Directors Workspace deployment only, used by compose.directors.yaml.
# The same secret is INTELLIGENCE_BRIDGE_SECRET on the Vercel project.
# MERITUS_PORTAL_BRIDGE_SECRET=
# Example: ["intelligence-service.example.com","localhost","127.0.0.1"]
# MERITUS_API_ALLOWED_HOSTS=
